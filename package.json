{
  "name": "aura-farmer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aura Farmer — a Cartoon 2D browser roguelite",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "assets:inventory": "node scripts/asset-inventory.mjs",
    "validate:local": "node scripts/validate-local.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.15.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
